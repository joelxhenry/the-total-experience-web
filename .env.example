# Public site URL used to build review links in invite emails (no trailing slash).
SITE_URL=http://localhost:3000

# --- Admin auth (P0.5) ---
# Plaintext admin password; compared via timing-safe equal.
ADMIN_PASSWORD=change-me
# 32+ byte random string used as HMAC key for the admin_session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# --- Email transport: Resend ---
# Server API key from https://resend.com/api-keys. When unset, sendInviteEmail
# logs the email + review link to the server console instead of sending.
RESEND_API_KEY=
# From address. Must be on a domain you've verified in Resend (or use
# "onboarding@resend.dev" for quick testing).
MAIL_FROM="The Total Experience <no-reply@example.com>"

# --- Supabase (database) ---
# Project URL, e.g. https://abcdefghijklmno.supabase.co
SUPABASE_URL=
# Service role key (Settings → API → service_role). Server-only — never expose
# to the client. Bypasses RLS so the Nitro server can read/write invites & reviews.
SUPABASE_SERVICE_ROLE_KEY=