# Public site URL used to build review links in invite emails (no trailing slash).
SITE_URL=http://localhost:3000

# --- Admin auth (P0.5) ---
# Plaintext admin password; compared via timing-safe equal.
ADMIN_PASSWORD=change-me
# 32+ byte random string used as HMAC key for the admin_session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# --- SMTP / nodemailer (P0.4) ---
# When SMTP_HOST, SMTP_USER, or SMTP_PASS is missing, sendInviteEmail logs the
# email + review link to the server console instead of sending. Useful in dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="The Total Experience <no-reply@example.com>"
